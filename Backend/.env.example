# Copy to Backend/.env and fill in real values. Never commit .env.

PORT=5000
MONGO_URL=mongodb://localhost:27017/brandify

# Use long random strings, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFERESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Gmail account + app password used to send OTP and password-reset emails
EMAIL_USER=your-address@gmail.com
EMAIL_PASS=your-gmail-app-password
